# 复制为 .env 并填入真实值(.env 不会被 commit)

# ── LLM(豆包 Doubao) ──────────────────────────────────────────
ARK_API_KEY=
ARK_EP=                      # 模型 endpoint id,如 ep-xxxx 或 doubao-seed-2-0-lite-xxxx
# 或使用 LLM_* 变量(优先级更高):
# LLM_API_KEY=
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-xxxx

# ── Web 搜索(多供应商,自动降级) ──────────────────────────────
# 主力:Brave(免费额度大,推荐)。注册 https://brave.com/search/api/
BRAVE_API_KEY=
# 备选:Tavily(注册 https://tavily.com,免费额度较小,易触额度上限 432)
TAVILY_API_KEY=
# 兜底:DuckDuckGo(无需 key,pip 装 ddgs 即自动可用,无 key 也能采集)
# 顺序覆盖(可选):SEARCH_PROVIDER=brave,ddg   留空=auto(按可用性自动编排)
# 搜索结果磁盘缓存:TAVILY_CACHE=0 关闭;TAVILY_CACHE_TTL_HOURS=72 调 TTL
